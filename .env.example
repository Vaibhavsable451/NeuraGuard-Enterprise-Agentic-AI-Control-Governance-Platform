# ==============================================================================
# NeuraGuard Enterprise Control Plane — Environment Configuration Template
# Copy this file to '.env' and fill in your actual API keys.
# ==============================================================================

# --- App Settings ---
APP_ENV=local
MOCK_MODE=false              # false = call live Groq & Pinecone APIs; true = local mock
DATA_DIR=data
LOG_LEVEL=INFO

# --- LLM Provider: Groq (Primary) ---
# Get your free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- LLM Provider: Azure OpenAI / Azure AI (Optional Secondary) ---
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Vector Database: Pinecone ---
# Get your free API key at https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=neuraguard-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=384

# --- Governance & Risk Engine ---
RISK_BLOCK_THRESHOLD=85
RISK_REVIEW_THRESHOLD=50

# --- CI/CD & Evaluation Thresholds ---
THRESHOLD_OVERALL=90
THRESHOLD_GROUNDEDNESS=90
THRESHOLD_SECURITY=90
THRESHOLD_CRITICAL_VULNS=0

# --- Streamlit Frontend ---
NEURAGUARD_API_BASE=http://127.0.0.1:8000
